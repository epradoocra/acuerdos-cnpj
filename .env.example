# Copie este archivo a .env (desarrollo local y migración). En Azure, estas mismas variables se definen en
# App Service > Configuración > Variables de entorno. NUNCA suba el archivo .env a GitHub.

# --- Microsoft SQL Server / Azure SQL Database ---
MSSQL_HOST=miservidor.database.windows.net
MSSQL_PORT=1433
MSSQL_DB=acuerdos
MSSQL_USER=usuario_app
MSSQL_PASSWORD=cambie-esta-contrasena
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# MSSQL_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no;Connection Timeout=60

# --- Django ---
DJANGO_SECRET_KEY=cambie-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=0
# En Azure el dominio *.azurewebsites.net se agrega solo; añada aquí dominios propios si los hay.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# En Azure use una ruta persistente: /home/media
DJANGO_MEDIA_ROOT=

# Modo de prueba: 1 = cualquier usuario con sesión puede agregar y modificar datos. Use 0 con información real.
DJANGO_MODO_PRUEBA=0

# Carga de los acuerdos de la LIV sesión al arrancar. 0 si los datos se migraron desde el sistema anterior.
CARGAR_LIV=0

# Superusuario inicial (opcional; si migró los datos, el usuario admin ya existe)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Correo y recuperación de la cuenta de administrador ---
# Google Workspace: use una "contraseña de aplicación" de la cuenta que envía, no su contraseña normal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
# Único correo que recibe la liga para cambiar la contraseña del administrador
ADMIN_RESET_EMAIL=
# Dirección pública del portal (opcional en Azure: se toma WEBSITE_HOSTNAME)
PORTAL_URL=
